<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>crospi_core</name>
  <version>0.0.0</version>
  <description>Package that allows running eTaSL task specifications in a ROS2 environment</description>
  <maintainer email="santiago.iregui@kuleuven.be">santiregui</maintainer>
  <license>LGPL-3.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <!-- Dependencies of the exported libraries (also exported in CMakeLists.txt: crospi_core_exported_dependencies).
       <depend> makes them transitive, so plugins only need <depend>crospi_core</depend>. -->
  <depend>etasl_wrapper</depend>
  <depend>crospi_interfaces</depend>
  <depend>ament_index_cpp</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>rclcpp_action</depend>
  <depend>pluginlib</depend>
  <depend>resource_retriever</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>eigen</depend>
  <depend>libjsoncpp-dev</depend>
  <depend>fmt</depend>
  <depend>boost</depend>

  <!-- Only used by the crospi_node executable -->
  <depend>std_srvs</depend>
  <depend>lifecycle_msgs</depend>

  <depend>lua-dev</depend>
  <depend>tree</depend>
  <depend>cmake</depend>

  <!-- Python packages used by the crospi_application_template (schema bundling and validation).
       jsonref has no rosdep rule and is not packaged by Ubuntu: install it with "pip3 install jsonref". -->
  <exec_depend>python3-jsonschema</exec_depend>
  
  <exec_depend>python3-colorama</exec_depend>

  <!-- <build_depend>crospi_interfaces</build_depend> -->

  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <!-- <exec_depend>crospi_core_default_plugins</exec_depend> -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- For python library: -->
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <exec_depend>python3</exec_depend>

  
  
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
